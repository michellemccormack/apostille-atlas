---
// "Get it done for me" call to action. Links to the request form, pre-selecting the state,
// and to Apostille-USA when a direct service request fits the page.
import Aff from './Aff.astro';
const { state = '', federal = false } = Astro.props;
const href = state ? `/get-it-done/?state=${encodeURIComponent(state)}` : '/get-it-done/';
// State guides: original and true-copy links. Pages that also cover federal documents
// (or that pass federal={true}) also get the U.S. Department of State link.
const showFederal = federal || !state;
---
<div class="helpcta">
  <p class="helpcta-h">Rather not do this yourself?</p>
  <p>Tell us the document, {state ? `that it was issued in ${state}` : 'the state that issued it'}, and where it's going. We'll pass your request to an independent apostille service that can handle the whole thing, and they'll reply with a quote. It's free to ask and you're under no obligation.</p>
  <p><a class="btn" href={href}>Get it done for me</a></p>
  <p>You can also start a request with Apostille-USA. Use the link that matches your document:</p>
  <ul>
    <li><Aff id="apostille-usa" href="https://apstl.us/0RTwQf" text="Apostille-USA, original document" /></li>
    <li><Aff id="apostille-usa" href="https://apstl.us/Qu73QB" text="Apostille-USA, true (certified) copy" /></li>
    {showFederal && <li><Aff id="apostille-usa" href="https://apstl.us/VbYPEP" text="Apostille-USA, federal (U.S. Department of State) apostille" /></li>}
  </ul>
  <p>See the <a href="/affiliate-disclosure/">affiliate disclosure</a> for how those links work.</p>
</div>
