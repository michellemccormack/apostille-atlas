---
import Base from '../../layouts/Base.astro';
const title = 'Request received';
const description = 'Your apostille request was sent.';
---
<Base title={title} description={description} updated="2026-11-23" noindex={true}>
  <h1>Thanks, your request was sent</h1>
  <p class="lede">We'll pass it to an independent apostille service that can handle your document. Expect an email from them with a price and a timeline.</p>
  <p>Nothing is charged unless you accept a quote and pay the service directly. If you don't hear back within two business days, check your spam folder or write to <a href="mailto:ds59tmmv@mail.grokbot.com">ds59tmmv@mail.grokbot.com</a>.</p>
  <p><a href="/">Back to the state guides</a></p>
</Base>
