---
import Base from '../layouts/Base.astro';
import HelpCTA from '../components/HelpCTA.astro';
import Src from '../components/Src.astro';
const title = 'How to get an apostille in Georgia';
const description = 'Georgia apostilles come from the Superior Court Clerks’ Cooperative Authority (GSCCCA) in Atlanta, not the Secretary of State: $3 per document, walk-in with no appointment, mail usually one to two business days, and no county certification for notarized documents.';
const PAGE = 'https://www.gsccca.org/notary-and-apostilles/apostilles/general-apostille-information';
const LIST = 'https://www.gsccca.org/notary-and-apostilles/apostilles/hague-apostille-country-list';
