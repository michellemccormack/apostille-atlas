import HelpCTA from '../components/HelpCTA.astro';
const title = 'How to verify an apostille: online e-Registers and the issuing office';
const description = 'How to check that a U.S. apostille is genuine: the states with an online e-Register listed by the Hague Conference (November 2026), what to enter, and who to contact when there is no online search.';
const ABC = 'https://assets.hcch.net/docs/6dd54368-bebd-4b10-a078-0a92e5bca40a.pdf';
const HB = 'https://assets.hcch.net/docs/a19ae90b-27bf-4596-b5ee-0140858abeaa.pdf';
const CHART = 'https://assets.hcch.net/docs/e8e7549d-e34a-452f-9fa3-cf2241aa4197.pdf';
