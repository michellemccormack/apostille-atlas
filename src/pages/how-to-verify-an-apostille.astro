  { s: 'Delaware', url: 'https://icis.corp.delaware.gov/ecorp2/services/validate' },
  { s: 'Kentucky', url: 'https://web.sos.ky.gov/apostille/verification.aspx', e: 'Issues e-Apostilles (from May 2024)' },
  { s: 'Minnesota', url: 'https://apostille.sos.state.mn.us/Search', g: '/minnesota-apostille/', e: 'e-Apostille pilot March 15, 2024, to September 30, 2025' },
  { s: 'Montana', url: 'https://biz.sosmt.gov/apostille', e: 'Issues e-Apostilles (from February 2023)' },
  { s: 'Nevada', url: 'https://esos.nv.gov/AuthenticationSearch/Index' },
  { s: 'New York', url: 'https://apostille2-verify.dos.ny.gov/ASPLCNSApostilleVerify/ApostilleVerify.aspx', g: '/new-york-apostille/' },
  { s: 'North Carolina', url: 'http://www.secretary.state.nc.us/verification/', g: '/north-carolina-apostille/' },
  { s: 'Rhode Island', url: 'https://business.sos.ri.gov/Apostille/ApostilleSearch', e: 'e-Apostille pilot November 1, 2023, to September 30, 2025' },
  { s: 'Tennessee', url: 'https://tncab.tnsos.gov/portal/apostille-search' },
  { s: 'Texas', url: 'https://sosdirectws.sos.state.tx.us/pdfondemand/CertVerification.aspx', g: '/texas-apostille/' },
