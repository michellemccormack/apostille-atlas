const US_AUTH = 'https://www.hcch.net/en/states/authorities/details3/?aid=353';
// U.S. e-Registers in the HCCH e-APP Implementation Chart (PDF created November 25, 2026).
// Where a chart link redirects, the URL it lands on is used.
const REGS = [
  { s: 'Arkansas', url: 'http://bcs.sos.arkansas.gov/AuthenticationSearch/ApostilleCertificateSearch' },
  { s: 'California', url: 'https://apostille-search.sos.ca.gov/', g: '/california-apostille/' },
  { s: 'Colorado', url: 'https://www.coloradosos.gov/auth/VerifyApostilleSearch.do', g: '/colorado-apostille/' },
